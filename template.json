{
  "$schema": "https://railway.com/template.schema.json",
  "description": "InvoicePlane — Self-hosted open source invoicing application with MariaDB. One-click deploy to Railway.",
  "services": {
    "InvoicePlane": {
      "source": {
        "github": {
          "repo": "BURNI80/InvoicePlane-railway-template",
          "branch": "master"
        }
      },
      "variables": {
        "IP_URL": "${{RAILWAY_PUBLIC_DOMAIN}}",
        "IP_DB_HOSTNAME": "${{MariaDB.MARIADB_HOST}}",
        "IP_DB_USERNAME": "${{MariaDB.MARIADB_USER}}",
        "IP_DB_PASSWORD": "${{MariaDB.MARIADB_PASSWORD}}",
        "IP_DB_DATABASE": "${{MariaDB.MARIADB_DATABASE}}",
        "IP_DB_PORT": "${{MariaDB.MARIADB_PORT}}",
        "ENCRYPTION_KEY": "${{secret(32)}}",
        "CI_ENV": "production",
        "ENABLE_DEBUG": "false",
        "DEFAULT_LANGUAGE": "english",
        "DEFAULT_ADMIN_EMAIL": "admin@localhost",
        "TZ": "UTC",
        "X_FRAME_OPTIONS": "SAMEORIGIN",
        "ENABLE_X_CONTENT_TYPE_OPTIONS": "true",
        "SESS_MATCH_IP": "true",
        "SESS_REGENERATE_DESTROY": "true"
      },
      "sleepApplication": true,
      "volumes": [
        "/var/www/html/uploads",
        "/var/www/html/storage"
      ]
    },
    "MariaDB": {
      "source": {
        "image": "mariadb:11.4"
      },
      "variables": {
        "MARIADB_ROOT_PASSWORD": "${{secret(24)}}",
        "MARIADB_DATABASE": "invoiceplane",
        "MARIADB_USER": "invoiceplane",
        "MARIADB_PASSWORD": "${{secret(24)}}"
      },
      "volumes": [
        "/var/lib/mysql"
      ]
    }
  }
}
